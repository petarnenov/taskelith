                "$ref": "#/components/schemas/Generation"
              },
              "cancelled": {
                "type": "boolean",
                "description": "Whether cancellation was requested before the attempt ended."
              },
              "endedAt": {
                "$ref": "#/components/schemas/Instant"
              },
              "executionId": {
                "$ref": "#/components/schemas/Identifier"
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ownershipGeneration",
              "cancelled",
              "endedAt"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "const": "not-started"
              },
              "ownershipGeneration": {
                "$ref": "#/components/schemas/Generation"
              },
              "cancelled": {
                "type": "boolean",
                "description": "Whether cancellation was requested before the attempt ended."
              },
              "endedAt": {
                "$ref": "#/components/schemas/Instant"
              }
            }
          }
        ]
      },
      "TaskResult": {
        "description": "Pending until an attempt of the task ends; then the outcome fact of its last ended attempt, at the ownership generation that attempt ended in, and the evidence published for the task.",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "runId",
              "taskId"
            ],
            "properties": {
