              },
              "taskId": {
                "$ref": "#/components/schemas/Identifier"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "runId",
              "taskId",
              "attemptId",
              "ownershipGeneration",
              "outcome",
              "evidence"
            ],
            "properties": {
