              "kind",
              "ownershipGeneration",
              "cancelled",
              "endedAt",
              "executionId",
              "status",
              "startProven"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "const": "exited"
              },
              "ownershipGeneration": {
                "$ref": "#/components/schemas/Generation"
              },
              "cancelled": {
                "type": "boolean",
                "description": "Whether cancellation was requested before the attempt ended."
              },
              "endedAt": {
                "$ref": "#/components/schemas/Instant"
              },
              "executionId": {
                "$ref": "#/components/schemas/Identifier"
              },
              "status": {
                "$ref": "#/components/schemas/ExitStatus"
              },
              "startProven": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ownershipGeneration",
              "cancelled",
