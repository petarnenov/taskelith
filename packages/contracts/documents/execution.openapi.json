      "EvidencePublication": {
        "type": "object",
        "additionalProperties": false,
        "description": "An evidence record as its producer publishes it.",
        "required": [
          "evidenceId",
          "projectId",
          "runId",
          "taskId",
          "attemptId",
          "kind",
          "inputArtifacts",
          "contentDigest",
          "contentType",
          "sizeBytes",
          "capturedAt"
        ],
        "properties": {
          "evidenceId": {
            "$ref": "#/components/schemas/Identifier",
            "description": "Chosen by the producer, so that a retried publication cannot create a second record."
          },
          "projectId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "runId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "taskId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "attemptId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "executionId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "kind": {
            "$ref": "#/components/schemas/Identifier",
            "description": "What the evidence is, such as an execution log or a validator report."
          },
          "inputArtifacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtifactRevision"
            }
          },
          "codeRevision": {
            "$ref": "#/components/schemas/Identifier"
          },
          "validator": {
            "type": "object",
            "additionalProperties": false,
            "description": "The validator or reviewer that produced the evidence.",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "$ref": "#/components/schemas/Identifier"
              },
              "version": {
                "$ref": "#/components/schemas/Identifier"
              }
            }
          },
          "outcome": {
            "$ref": "#/components/schemas/Identifier",
            "description": "The outcome the evidence records, defined by its kind."
          },
          "contentDigest": {
            "$ref": "#/components/schemas/ContentDigest"
          },
          "contentType": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "capturedAt": {
            "$ref": "#/components/schemas/Instant"
          }
        }
      },
