{
  "name": "taskelith",
  "version": "0.1.0",
  "description": "Self-hosted software factory for parallel project development. Bootstrap CLI and architecture plan.",
  "type": "module",
  "license": "MIT",
  "author": "Petar Nenov",
  "bin": {
    "taskelith": "dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/architecture.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petarnenov/taskelith.git"
  },
  "homepage": "https://github.com/petarnenov/taskelith#readme",
  "bugs": {
    "url": "https://github.com/petarnenov/taskelith/issues"
  },
  "keywords": [
    "software-factory",
    "agents",
    "sdlc",
    "typescript",
    "self-hosted"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "prepack": "npm run build",
    "openspec": "openspec",
    "release": "semantic-release",
    "verify:package": "node --experimental-strip-types scripts/verify-package.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.19.2",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3"
  }
}
